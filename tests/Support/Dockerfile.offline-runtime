# Reuse an already verified local runtime when external dependency registries are unavailable.
# This is only valid when composer.lock matches that runtime; normal release builds use Dockerfile.
ARG BASE_IMAGE=inventory-operations-app:latest
FROM ${BASE_IMAGE}
COPY --chown=www-data:www-data app ./app
COPY --chown=www-data:www-data config ./config
COPY --chown=www-data:www-data public ./public
COPY --chown=www-data:www-data scripts ./scripts
COPY --chown=www-data:www-data views ./views
