# Copy outside Git; replace passwords. Existing volumes retain their original credentials.
DB_DATABASE=inventory_order_management_restore
DB_VOLUME_NAME=inventory-restore-production_mysql-data
DB_USERNAME=inventory_app
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
TLS_DIRECTORY=/absolute/path/to/tls
HTTP_BIND=127.0.0.1
HTTPS_BIND=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
