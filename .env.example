APP_NAME="Inventory & Order Management"
APP_ENV=local
APP_DEBUG=true
APP_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_DATABASE=inventory_order_management
DB_USERNAME=inventory_app
DB_PASSWORD=change_me_for_local_only
DB_ROOT_PASSWORD=change_me_root_for_local_only

# Seconds; limits are checked on every authenticated request, independently of GC.
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
SESSION_ROTATION_SECONDS=900
# auto enables Secure for APP_ENV=production. Set true for trusted TLS termination.
SESSION_COOKIE_SECURE=auto

# Negotiated sales prices (D-13, ADR-019): Sales may sell at most this percent below the master selling price.
# Whole number 0-100; Admin has no cap. No line may be sold below the product's purchase price.
SALES_MAX_DISCOUNT_PERCENT=10

# Batch/lot expiry (D-17, ADR-023): business time zone of the expiry rule (a lot is expired when its expiry date is
# before today in this zone) and the near-expiry window in days (1-365) for the Expiry report and dashboard.
APP_TIMEZONE=Asia/Jakarta
NEAR_EXPIRY_DAYS=30

# Stock count sessions (D-18, ADR-024): a counted line is within tolerance (no recount needed) when
# |variance| <= max(UNITS, expected x PERCENT / 100). PERCENT 0-100, UNITS in base units (0 or more).
COUNT_RECOUNT_TOLERANCE_PERCENT=2
COUNT_RECOUNT_TOLERANCE_UNITS=0

# Invoices with PPN (D-19, ADR-025). ASSUMPTIONS to be verified by a tax adviser: prices exclude PPN; PPN = VAT_RATE_PERCENT
# of a DPP of VAT_DPP_NUMERATOR/VAT_DPP_DENOMINATOR of the net amount (12 % of 11/12 = effective 11 %); DPP and PPN are
# rounded to whole Rupiah, half up, per invoice. Rate 0-100; 1 <= numerator <= denominator <= 1000. Each invoice keeps a
# snapshot of these values. INVOICE_PAYMENT_TERMS_DAYS (0-365) sets the due date. Invalid values stop the app at boot.
VAT_RATE_PERCENT=12
VAT_DPP_NUMERATOR=11
VAT_DPP_DENOMINATOR=12
INVOICE_PAYMENT_TERMS_DAYS=30
