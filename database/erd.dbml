// Inventory & Order Management System — ERD
// Generated from database/schema-and-seed.sql
// Import at https://dbdiagram.io (or https://dbdocs.io) — paste this file's content directly.
Project inventory_order_management {
  database_type: 'MySQL'
  Note: 'Inventory & Order Management System — schema exported from database/schema-and-seed.sql'
}

Table schema_versions {
  id int [pk, increment, note: 'INT UNSIGNED AUTO_INCREMENT']
  version varchar(50) [not null, unique]
  description varchar(255) [not null]
  applied_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table users {
  id int [pk, increment, note: 'INT UNSIGNED AUTO_INCREMENT']
  name varchar(120) [not null]
  email varchar(190) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null, note: 'ENUM(Admin, Sales, WarehouseStaff)']
  is_active tinyint [not null, default: 1]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (role, is_active) [name: 'idx_users_role_active']
  }
}

Table categories {
  id int [pk, increment]
  name varchar(120) [not null, unique]
  description varchar(255) [not null, default: '']
  is_active tinyint [not null, default: 1]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    is_active [name: 'idx_categories_active']
  }
}

Table warehouses {
  id int [pk, increment]
  name varchar(120) [not null, unique]
  location varchar(190) [not null, default: '']
  is_active tinyint [not null, default: 1]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    is_active [name: 'idx_warehouses_active']
  }
}

Table products {
  id int [pk, increment]
  category_id int [not null]
  sku varchar(80) [not null, unique]
  name varchar(160) [not null]
  unit varchar(30) [not null]
  purchase_price decimal(14,2) [not null, default: 0.00, note: 'CHECK >= 0']
  selling_price decimal(14,2) [not null, default: 0.00, note: 'CHECK >= 0']
  price decimal(14,2) [not null, default: 0.00, note: 'CHECK >= 0']
  reorder_point int [not null, default: 0, note: 'CHECK >= 0']
  is_active tinyint [not null, default: 1]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (category_id, is_active) [name: 'idx_products_category_active']
    name [name: 'idx_products_name']
  }
}

Table product_stocks {
  product_id int [not null]
  warehouse_id int [not null]
  quantity int [not null, default: 0, note: 'CHECK >= 0']
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (product_id, warehouse_id) [pk]
    warehouse_id [name: 'idx_product_stocks_warehouse']
  }
}

Table suppliers {
  id int [pk, increment]
  name varchar(120) [not null, unique]
  email varchar(190) [not null, default: '']
  phone varchar(40) [not null, default: '']
  address varchar(255) [not null, default: '']
  is_active tinyint [not null, default: 1]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    is_active [name: 'idx_suppliers_active']
  }
}

Table customers {
  id int [pk, increment]
  name varchar(120) [not null, unique]
  email varchar(190) [not null, default: '']
  phone varchar(40) [not null, default: '']
  address varchar(255) [not null, default: '']
  is_active tinyint [not null, default: 1]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    is_active [name: 'idx_customers_active']
  }
}

Table purchase_orders {
  id int [pk, increment]
  order_number varchar(50) [not null, unique]
  supplier_id int [not null]
  destination_warehouse_id int [not null]
  status varchar(20) [not null, default: 'Draft', note: 'ENUM(Draft, Ordered, PartiallyReceived, Received, Cancelled)']
  order_date date [not null]
  created_by int [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (status, order_date) [name: 'idx_purchase_orders_status_date']
    supplier_id [name: 'idx_purchase_orders_supplier']
    destination_warehouse_id [name: 'idx_purchase_orders_warehouse']
  }
}

Table purchase_order_items {
  id int [pk, increment]
  purchase_order_id int [not null]
  product_id int [not null]
  quantity int [not null, note: 'CHECK > 0']
  received_quantity int [not null, default: 0, note: 'CHECK 0 <= received_quantity <= quantity']
  purchase_price decimal(14,2) [not null, default: 0.00, note: 'CHECK >= 0']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (purchase_order_id, product_id) [unique, name: 'uq_purchase_order_items_po_product']
    product_id [name: 'idx_purchase_order_items_product']
  }
}

Table stock_ledger {
  id bigint [pk, increment]
  product_id int [not null]
  warehouse_id int [not null]
  movement_type varchar(10) [not null, note: 'ENUM(Receipt, Issue, Adjustment)']
  quantity int [not null, note: 'CHECK > 0; absolute size of the movement']
  quantity_delta bigint [note: 'Signed change, required for Adjustment and NULL otherwise; CHECK ABS(quantity_delta) = quantity']
  reference_type varchar(20) [not null, note: 'PO, SO or stock operation reference']
  reference_id int [not null]
  performed_by int [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (product_id, warehouse_id) [name: 'idx_stock_ledger_product_warehouse']
    (reference_type, reference_id) [name: 'idx_stock_ledger_reference']
  }

  Note: 'Append-only ledger under normal application operation.'
}

Table audit_logs {
  id bigint [pk, increment]
  actor_id int [null]
  action varchar(80) [not null]
  entity_type varchar(80) [not null]
  entity_id int [null]
  status varchar(10) [not null, note: 'ENUM(success, failure, blocked)']
  ip_address varchar(45) [not null, default: '']
  user_agent varchar(255) [not null, default: '']
  metadata_json json [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (actor_id, created_at) [name: 'idx_audit_logs_actor_time']
    (entity_type, entity_id, created_at) [name: 'idx_audit_logs_entity_time']
    (action, created_at) [name: 'idx_audit_logs_action_time']
  }
}

Table login_attempts {
  id bigint [pk, increment]
  email varchar(190) [not null]
  ip_address varchar(45) [not null]
  successful tinyint [not null, default: 0]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (email, ip_address, created_at) [name: 'idx_login_attempts_subject_time']
    created_at [name: 'idx_login_attempts_created_at']
  }
}

Table sales_orders {
  id int [pk, increment]
  order_number varchar(50) [not null, unique]
  customer_id int [not null]
  source_warehouse_id int [not null]
  status varchar(20) [not null, default: 'Draft', note: 'ENUM(Draft, PendingApproval, Approved, Fulfilled, Cancelled)']
  order_date date [not null]
  created_by int [not null]
  approved_by int [null]
  approved_at timestamp [null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (status, order_date) [name: 'idx_sales_orders_status_date']
    customer_id [name: 'idx_sales_orders_customer']
    source_warehouse_id [name: 'idx_sales_orders_warehouse']
    created_by [name: 'idx_sales_orders_created_by']
  }
}

Table sales_order_items {
  id int [pk, increment]
  sales_order_id int [not null]
  product_id int [not null]
  quantity int [not null, note: 'CHECK > 0']
  selling_price decimal(14,2) [not null, default: 0.00, note: 'CHECK >= 0']
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  updated_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (sales_order_id, product_id) [unique, name: 'uq_sales_order_items_so_product']
    product_id [name: 'idx_sales_order_items_product']
  }
}

// ---------- Relationships ----------

Ref: products.category_id > categories.id

Ref: product_stocks.product_id > products.id
Ref: product_stocks.warehouse_id > warehouses.id

Ref: purchase_orders.supplier_id > suppliers.id
Ref: purchase_orders.destination_warehouse_id > warehouses.id
Ref: purchase_orders.created_by > users.id

Ref: purchase_order_items.purchase_order_id > purchase_orders.id [delete: cascade]
Ref: purchase_order_items.product_id > products.id

Ref: stock_ledger.product_id > products.id
Ref: stock_ledger.warehouse_id > warehouses.id
Ref: stock_ledger.performed_by > users.id

Ref: audit_logs.actor_id > users.id [delete: set null]

Ref: sales_orders.customer_id > customers.id
Ref: sales_orders.source_warehouse_id > warehouses.id
Ref: sales_orders.created_by > users.id
Ref: sales_orders.approved_by > users.id

Ref: sales_order_items.sales_order_id > sales_orders.id [delete: cascade]
Ref: sales_order_items.product_id > products.id

// Optional business operations (ADR-008, ADR-009), added 2026-10-07 from database/schema-and-seed.sql.

Table purchase_order_closures {
  purchase_order_id int [pk, note: 'One closure per PO; closes the unreceived remainder, keeps received goods (D-01)']
  closed_by int [not null]
  reason varchar(500) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table sales_order_rejections {
  sales_order_id int [pk, note: 'Rejection reason kept separately; the SO status becomes Cancelled (D-02)']
  rejected_by int [not null]
  reason varchar(500) [not null]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
}

Table inventory_operations {
  id int [pk, increment]
  kind varchar(20) [not null, note: 'ENUM(Adjustment, Transfer, SupplierReturn, CustomerReturn)']
  status varchar(20) [not null, default: 'PendingApproval', note: 'ENUM(PendingApproval, Approved, Rejected, Posted, Cancelled)']
  warehouse_id int [not null]
  destination_id int [note: 'Required and different from warehouse_id only for Transfer']
  reason varchar(500) [not null]
  decision_reason varchar(500)
  condition_confirmed boolean [not null, default: false, note: 'CHECK true for CustomerReturn']
  created_by int [not null]
  approved_by int [note: 'CHECK approved_by <> created_by (independent approval)']
  posted_by int
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]
  approved_at timestamp
  posted_at timestamp

  indexes {
    (status, created_at) [name: 'idx_inventory_operations_status_time']
  }
}

Table inventory_operation_items {
  id bigint [pk, increment]
  operation_id int [not null]
  product_id int [not null]
  quantity int [not null, note: 'Counted quantity for Adjustment, moved quantity otherwise']
  baseline int [note: 'Stock observed at count time; posting rejects a stale baseline']
  source_ledger_id bigint [note: 'Original receipt/issue for returns']

  indexes {
    (operation_id, product_id) [unique, name: 'uq_operation_product']
    source_ledger_id [name: 'idx_operation_source']
  }
}

Table inventory_return_totals {
  source_ledger_id bigint [pk, note: 'Locked per original movement to serialise concurrent returns']
  returned_quantity int [not null, default: 0]
}

Table operation_requests {
  id bigint [pk, increment]
  actor_id int [not null]
  request_key char(32) [not null, note: 'Idempotency key from the form']
  payload_hash char(64) [not null]
  completed boolean [not null, default: false]
  created_at timestamp [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    (actor_id, request_key) [unique, name: 'uq_operation_request_actor_key']
  }
}

Ref: purchase_order_closures.purchase_order_id - purchase_orders.id
Ref: purchase_order_closures.closed_by > users.id
Ref: sales_order_rejections.sales_order_id - sales_orders.id
Ref: sales_order_rejections.rejected_by > users.id
Ref: inventory_operations.warehouse_id > warehouses.id
Ref: inventory_operations.destination_id > warehouses.id
Ref: inventory_operations.created_by > users.id
Ref: inventory_operations.approved_by > users.id
Ref: inventory_operations.posted_by > users.id
Ref: inventory_operation_items.operation_id > inventory_operations.id
Ref: inventory_operation_items.product_id > products.id
Ref: inventory_operation_items.source_ledger_id > stock_ledger.id
Ref: inventory_return_totals.source_ledger_id - stock_ledger.id
Ref: operation_requests.actor_id > users.id
